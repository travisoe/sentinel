# Sentinel Compliance Platform — environment variables
# Copy to .env.local for development. NEVER commit real values.
# With Google vars unset, the app runs on an in-memory demo store (zero secrets).

# --- Google Sheets backend (server-side only; never exposed to the browser) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Master Index workbook: columns Client | Spreadsheet ID | Pack | Status
MASTER_INDEX_SHEET_ID=

# --- Auth ---
# Random secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# Optional JSON array of app users. If unset, safe demo defaults are used:
#   admin@sentinel / sentinel  (role: sentinel)
#   manager@demo   / demo       (role: owner, client: "Demo Warehouse")
# Example:
# AUTH_USERS=[{"email":"you@co.com","password":"...","role":"owner","client":"Acme DC"}]
AUTH_USERS=

# --- App ---
APP_BASE_URL=https://app.sentinelsafety.io
