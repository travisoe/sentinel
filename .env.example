# Sentinel Compliance Platform — environment variables
# Copy to .env.local for development. NEVER commit real values.
# With no backend configured, the app runs on an in-memory demo store.

# --- Supabase backend (primary) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Auth ---
# Random secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# Optional JSON array of app users. If unset, safe demo defaults are used:
#   admin@sentinel / sentinel  (role: sentinel)
#   manager@demo   / demo       (role: owner, client: "Demo Warehouse")
# Example:
# AUTH_USERS=[{"email":"you@co.com","password":"...","role":"owner","client":"Acme DC"}]
AUTH_USERS=
SENTINEL_ADMIN_EMAIL=
SENTINEL_ADMIN_PASSWORD=

# --- App ---
APP_BASE_URL=https://app.sentinelsafety.io

# --- Stripe Billing (use restricted key when possible) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WAREHOUSE_STARTER=
STRIPE_PRICE_WAREHOUSE_PLUS=
STRIPE_PRICE_WAREHOUSE_SETUP=
STRIPE_PRICE_HEALTHCARE_STARTER=
STRIPE_PRICE_HEALTHCARE_PLUS=
STRIPE_PRICE_HEALTHCARE_SETUP=
STRIPE_PRICE_MANAGED=
STRIPE_PRICE_MANAGED_SETUP=

# --- Scheduled health + weekly proof reports ---
CRON_SECRET=
RESEND_API_KEY=
REPORT_FROM_EMAIL=Sentinel <reports@sentinelsafety.io>

