# Sentinel Compliance Platform — environment variables
# Copy to .env.local for development. NEVER commit real values.
# With no backend configured, the app runs on an in-memory demo store.

# --- Supabase backend (primary) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Auth ---
# Random secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# Optional JSON array of app users. If unset, safe demo defaults are used:
#   admin@sentinel / sentinel  (role: sentinel)
#   manager@demo   / demo       (role: owner, client: "Demo Warehouse")
# Example:
# AUTH_USERS=[{"email":"you@co.com","password":"...","role":"owner","client":"Acme DC"}]
AUTH_USERS=

# --- App ---
APP_BASE_URL=https://app.sentinelsafety.io

# --- Google Sheets backend (legacy/optional; unused when Supabase is set) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
MASTER_INDEX_SHEET_ID=
